# Ежедневный сброс демо-базы: даты в демо-данных считаются от «сегодня».
# Копируется в /etc/systemd/system/orbita-reset.service (вместе с orbita-reset.timer).
# Приложение запускается обратно при любом исходе: ExecStopPost срабатывает, даже если сброс упал.
[Unit]
Description=Orbita - пересоздание демо-базы

[Service]
Type=oneshot
User=orbita
Group=orbita
WorkingDirectory=/opt/orbita
EnvironmentFile=/etc/orbita.env
# «+» — команда выполняется с правами root, несмотря на User=orbita
ExecStartPre=+/bin/systemctl stop orbita
ExecStart=/usr/bin/node --no-warnings scripts/reset-db.js
ExecStopPost=+/bin/systemctl start orbita

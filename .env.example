# Скопируйте в .env или задайте в настройках хостинга. Файл .env в git не попадает.
NODE_ENV=production
PORT=3000
# 32 случайных байта в base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_KEY=
# Необязательно: ключ Claude API для помощника «Спроси Орбиту». Без него работает локальный режим.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
